# =============================================================================
# ResQCare AI environment variables
# Copy to .env.local and fill in. Never commit .env.local.
#
# With nothing filled in, the app runs fully on its own:
#   DATA_BACKEND=memory   seeded in-memory store (fictional data, resets on restart)
#   AUTH_MODE=demo        role switcher instead of Firebase sign-in
# To use Firebase, fill in the two Firebase blocks below and set
#   DATA_BACKEND=firestore, AUTH_MODE=firebase, NEXT_PUBLIC_AUTH_MODE=firebase
# =============================================================================

# ---- Modes ------------------------------------------------------------------
# memory | firestore
DATA_BACKEND=memory
# demo | firebase   (server side; demo auth is refused when NODE_ENV=production)
AUTH_MODE=demo
# Must match AUTH_MODE; tells the browser which sign-in flow to show.
NEXT_PUBLIC_AUTH_MODE=demo
# Default for the "DEMO MODE. No real ambulance is dispatched." flag
# (admins can change it at runtime in /admin/dashboard).
DEMO_MODE_DEFAULT=true
# Allows ?scenario=ai-down etc. (dev panel). Ignored when NODE_ENV=production.
DEV_SCENARIOS=true

# ---- Firebase web app config (CLIENT, public by design) ---------------------
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# These identify the project; security comes from Firebase Auth + security rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true = point the browser SDK at the local emulator suite (firebase emulators:start)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ---- Firebase Admin SDK (SERVER ONLY, secret) -------------------------------
# Firebase console > Project settings > Service accounts > Generate new private key.
# Copy project_id, client_email and private_key from the downloaded JSON.
# Keep the quotes and the literal \n sequences in the private key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Emulator hosts (set these instead of the service account for local emulator use).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---- Google APIs ------------------------------------------------------------
# Maps JavaScript API key (CLIENT). Restrict by HTTP referrer in Google Cloud console.
# Empty = map views fall back to the list.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional Map ID for advanced markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Routes API key (SERVER ONLY). Empty = straight-line estimates, flagged "approximate".
GOOGLE_ROUTES_API_KEY=
# Gemini key for intent extraction (SERVER ONLY). Empty = rule-based matching, flagged.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Security ---------------------------------------------------------------
# Bearer secret for POST /api/jobs/* (Vercel cron sends it). Generate: openssl rand -hex 32
CRON_SECRET=
# Salt for hashing IPs in rate limits and audit logs. Generate: openssl rand -hex 32
RATE_LIMIT_SALT=

# ---- Optional ---------------------------------------------------------------
# Base URL of a separately deployed API. Empty = same origin (/api).
NEXT_PUBLIC_API_BASE_URL=
